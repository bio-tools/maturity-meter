# Copy this file to .env for local development. Never commit .env.
MATURITY_METER_LOG_LEVEL=INFO

# HTTP server binding. Keep the loopback default for local development.
MATURITY_METER_SERVER_HOST=127.0.0.1
MATURITY_METER_SERVER_PORT=8000
MATURITY_METER_SERVER_ROOT_PATH=
MATURITY_METER_SERVER_RELOAD=false

# Set this when the public URL differs from the bind address, for example when
# deploying behind a reverse proxy. It is published in OpenAPI metadata.
# MATURITY_METER_PUBLIC_BASE_URL=https://example.org

# GitHub personal access token for the GitHub API. Optional, but without it
# requests are unauthenticated and heavily rate limited. Never commit a real one.
MATURITY_METER_GITHUB_TOKEN=

# GitLab personal access token (read_api scope) for the GitLab API. Optional for
# public projects. Never commit a real one.
MATURITY_METER_GITLAB_TOKEN=
